NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://family_app:CHANGE_ME@127.0.0.1:55432/family_case
SESSION_TTL_HOURS=8
CORS_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false

# DEV/TEST ONLY. When true, the password submitted for a new user or an admin
# password reset is also stored in user_password_log so the admin "users
# registry" screen can display it. Passwords are otherwise one-way hashed and
# cannot be recovered. Enabling this in production is refused at startup.
DEV_CAPTURE_PASSWORDS=false

# Required in production; use at least 16 random characters
BOOTSTRAP_SECRET=
